# BACKGROUND_REMOVAL_API_KEY: Server-side API key for the AI background removal provider (e.g., remove.bg).
# Never expose this key in client-side code.
BACKGROUND_REMOVAL_API_KEY="MY_BACKGROUND_REMOVAL_API_KEY"

# BACKGROUND_REMOVAL_API_URL: Endpoint URL for the background removal service.
BACKGROUND_REMOVAL_API_URL="https://api.remove.bg/v1.0/removebg"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
